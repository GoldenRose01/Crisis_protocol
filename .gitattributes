# Auto detect text files and normalize line endings.
* text=auto

# Source and documentation files.
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf

# Unity text-serialized assets.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.inputactions text eol=lf

# Large or non-mergeable assets are stored with Git LFS.
*LightingData.asset filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
